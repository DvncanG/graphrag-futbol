# Copiar a .env y ajustar
# 127.0.0.1 y no localhost: en Docker Desktop sobre Windows, localhost
# resuelve primero a IPv6 y el proxy acepta la conexion pero no la reenvia.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
# OJO: Neo4j fija esta contraseña en la PRIMERA inicializacion y la guarda
# dentro del volumen de Docker. Cambiarla despues no surte efecto: la base
# seguira pidiendo la antigua. Para cambiarla hay que hacer
# `docker compose down -v`, lo que destruye el grafo. Decidela antes del
# primer `docker compose up`.
NEO4J_PASSWORD=cambiame

# Ollama corriendo nativo en el host
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=bge-m3

# Ventana de contexto. CRITICO: el default de Ollama son 2048 tokens y
# trunca en silencio, lo que destroza la extraccion de entidades.
OLLAMA_NUM_CTX=8192